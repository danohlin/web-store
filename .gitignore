# --- Node / Backend ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
build/
coverage/
*.tsbuildinfo

# --- React / Frontend (Vite/CRA) ---
frontend/dist/
frontend/build/
frontend/.vite/

# --- Environment / Secrets ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Docker ---
*.log
docker-compose.override.yml

# --- Terraform ---
**/.terraform/*
# State holds every secret in plaintext, including generated DB passwords.
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example
crash.log
crash.*.log
.terraformrc
terraform.rc
# NOTE: .terraform.lock.hcl is deliberately NOT ignored. It pins provider
# versions and hashes, and committing it is what makes an apply reproducible.
override.tf
override.tf.json
*_override.tf
*_override.tf.json
tfplan
*.tfplan

# --- Cloud / cluster credentials ---
.aws/
credentials
*.kubeconfig
kubeconfig
kubeconfig-*
*.retry

# --- Kubernetes / Helm ---
*.kubeconfig
charts/*/charts/
charts/*/Chart.lock

# --- OS / Editor ---
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# --- Misc ---
*.tmp
*.bak
