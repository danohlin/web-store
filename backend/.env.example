# Copy to .env for local (non-Docker) development.
# In Kubernetes none of the secret values below come from env vars — they are
# mounted as files by the Secrets Store CSI driver (see SECRETS_DIR).

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Postgres. docker-compose provisions this database locally.
DATABASE_URL=postgresql://webstore:webstore@localhost:5432/webstore?schema=public

# Where the app looks for file-mounted secrets. When a file exists it wins over
# the corresponding environment variable. Unset locally.
# SECRETS_DIR=/mnt/secrets

# Local-only development secrets. NEVER set these in AWS — Terraform generates
# them and writes them straight to Secrets Manager.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
GUEST_CART_TTL_DAYS=30

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173

# Cookies are only marked Secure when this is true (requires HTTPS).
COOKIE_SECURE=false

# Mock gateway: 'mock' is the only implementation today.
PAYMENT_PROVIDER=mock

# Flat mock shipping/tax rules.
SHIPPING_FLAT_CENTS=599
FREE_SHIPPING_THRESHOLD_CENTS=5000
TAX_RATE_BASIS_POINTS=875
