# Normalise line endings. Without this, Git on Windows checks files out with
# CRLF, and any script that later lands in a Linux container fails with
# "bad interpreter: /bin/sh^M".
* text=auto eol=lf

# Files that must be LF regardless of platform, because they are executed or
# parsed inside Linux images.
*.sh            text eol=lf
Dockerfile      text eol=lf
*.Dockerfile    text eol=lf
.dockerignore   text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.sql           text eol=lf
*.tf            text eol=lf
*.tpl           text eol=lf

# Windows-only helper scripts keep CRLF.
*.ps1           text eol=crlf
*.cmd           text eol=crlf
*.bat           text eol=crlf

# Binary assets: never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary

# Generated lockfiles are noisy in review but must stay in the repo.
package-lock.json -diff linguist-generated=true
