# Copy to terraform.tfvars. Real .tfvars files are gitignored and blocked by the
# pre-commit hook.
#
# There is no account id, access key or password anywhere in here. The account
# comes from your AWS credentials, and every secret is generated by Terraform
# straight into Secrets Manager.

project     = "web-store"
environment = "dev"
region      = "us-east-1"

# --- cost dials -------------------------------------------------------------
# Off saves ~$0.045/hr, removes several minutes from both apply and destroy,
# and avoids the most common cause of a destroy hanging. Nodes then sit in
# public subnets with no inbound rules; the database stays fully private.
enable_nat_gateway = false

# Spot is roughly 70% cheaper and fine for an environment rebuilt daily.
node_capacity_type = "SPOT"
node_desired_size  = 2

# --- database ---------------------------------------------------------------
db_instance_class = "db.t4g.micro"
# Data is reseeded on every deploy, so nothing is worth keeping on destroy.
db_skip_final_snapshot = true

# --- guard rail -------------------------------------------------------------
# Set an address to get alerted at 80% actual and 100% forecast spend. Leave
# empty to skip creating the budget.
budget_notification_email = ""
budget_limit_usd          = 50

# --- optional ---------------------------------------------------------------
# Narrow this if your IP is stable. It stays open by default because the API
# still requires IAM auth, and a fixed CIDR blocks GitHub Actions runners.
# cluster_public_access_cidrs = ["203.0.113.4/32"]

# Extra principals to grant cluster admin, beyond whoever runs the apply.
# Use the CI role ARN here so GitHub Actions can deploy.
# cluster_admin_principals = ["arn:aws:iam::ACCOUNT:role/github-actions"]
