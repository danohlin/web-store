# Copy to backend.hcl and set the bucket from the persistent stack's output:
#   terraform -chdir=../persistent output -raw state_bucket
#
# Then initialise with:
#   terraform init -backend-config=backend.hcl
#
# The bucket name embeds your account id, which is why this file is an example
# rather than a committed default.

bucket = "web-store-tfstate-REPLACE_WITH_ACCOUNT_ID"
key    = "ephemeral/terraform.tfstate"
region = "us-east-1"

encrypt = true

# Native S3 state locking (Terraform 1.10+). Replaces the DynamoDB lock table
# the older pattern needed — one less resource to create, pay for and clean up.
use_lockfile = true
