# Copy to backend.hcl and fill in your account id, then:
#   terraform init -backend-config=backend.hcl
#
# backend.hcl is gitignored because the bucket name embeds the AWS account id,
# and this repository is public. The up and down scripts derive the same values
# from `aws sts get-caller-identity`, so they need no file.
#
# Find the bucket name with:
#   aws s3 ls | Select-String tfstate

bucket = "web-store-tfstate-REPLACE_WITH_ACCOUNT_ID"
key    = "persistent/terraform.tfstate"
region = "us-east-1"

encrypt = true

# Native S3 state locking (Terraform 1.10+); no DynamoDB table required.
use_lockfile = true
